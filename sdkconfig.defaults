CONFIG_IDF_TARGET="esp32c6"

# Measured with esptool flash-id on the soldered ESP32-C6 DevKit (2026-11-06).
# A move to a bare module is planned; re-check this then.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The default of 3584 is too small for the code ported from the Arduino loop task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
